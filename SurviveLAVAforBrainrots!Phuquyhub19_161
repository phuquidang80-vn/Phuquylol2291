local function CreateTabBtn(txtVn, txtEn, x, target, other)
    local b = Instance.new("TextButton", Main)
    b.Size = UDim2.new(0.46, 0, 0, 30)
    b.Position = UDim2.new(x, 0, 0.15, 0)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(function() target.Visible = true; other.Visible = false end)
    RunService.Heartbeat:Connect(function() b.Text = isEnglish and txtEn or txtVn end)
end

