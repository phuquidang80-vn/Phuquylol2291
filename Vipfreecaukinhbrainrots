-- --- HÀM DI CHUYỂN (DRAG) CHO MOBILE ---
local dragToggle, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragToggle = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragToggle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragToggle = false
    end
end)

-- --- LOGIC XỬ LÝ VIP ---
local VIP_ZONES = {
    "VIP1", "VIP2", "VIP3", "VIP4", "VIP5", "VIP8", "VIP9", "VIP10", "VIP11", "VIP12", "VIP13"
}

UnlockBtn.MouseButton1Click:Connect(function()
    for _, name in pairs(VIP_ZONES) do
        pcall(function()
            local zone = workspace.Map.Bridge.Tiles[name].Zone
            if zone then
                zone.CanCollide = false
                zone.Transparency = 0.7
                -- Xóa bỏ cảm biến chạm để tránh bị check VIP
                local touch = zone:FindFirstChildOfClass("TouchTransmitter")
                if touch then touch:Destroy() end
            end
        end)
    end
    UnlockBtn.Text = "SUCCESS!"
    UnlockBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
    wait(1.5)
    UnlockBtn.Text = "UNLOCK ALL VIP"
    UnlockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end)

-- --- XỬ LÝ ẨN/HIỆN ---
MiniBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
