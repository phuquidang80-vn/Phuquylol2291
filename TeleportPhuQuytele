local function CreateBtn(text, color, y, parent)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.92, 0, 0, 32)
    b.Position = UDim2.new(0.04, 0, 0, y)
    b.BackgroundColor3 = color
