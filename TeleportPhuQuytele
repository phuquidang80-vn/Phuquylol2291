-- DỊCH CHUYỂN
AddBtn.MouseButton1Click:Connect(function()
    local id = teleCount
    local pos = Player.Character.HumanoidRootPart.CFrame
    local btn = CreateBtn("", Color3.fromRGB(35, 35, 35), 0, Scroll)
    btn.MouseButton1Click:Connect(function() Player.Character.HumanoidRootPart.CFrame = pos end)
    table.insert(savedPositions, {ID = id, Btn = btn})
    teleCount = teleCount + 1
    Scroll.CanvasSize = UDim2.new(0, 0, 0, teleCount * 35)
    UpdateLang()
end)

ClearBtn.MouseButton1Click:Connect(function()
    for _, item in pairs(savedPositions) do item.Btn:Destroy() end
    savedPositions = {} teleCount = 1 UpdateLang()
end)

-- VÒNG LẶP HỆ THỐNG
RunService.RenderStepped:Connect(function()
    if shiftLockActive then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            local _, y = Camera.CFrame:ToEulerAnglesYXZ()
            Player.Character.HumanoidRootPart.CFrame = CFrame.new(Player.Character.HumanoidRootPart.Position) * CFrame.Angles(0, y, 0)
        end
    end
end)

RunService.Stepped:Connect(function()
    if noclipActive and Player.Character then
        for _, v in pairs(Player.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
    end
end)

local function CreateESP(p)
    local h = Instance.new("Highlight")
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    RunService.RenderStepped:Connect(function() if p.Character then h.Parent = p.Character h.Enabled = espActive end end)
end
for _, v in pairs(game.Players:GetPlayers()) do if v ~= Player then CreateESP(v) end end
game.Players.PlayerAdded:Connect(function(v) if v ~= Player then CreateESP(v) end end)

