        NoclipBtn.Text = noclipActive and "🧱 NOCLIP: ON" or "🧱 NOCLIP: OFF"
        EspBtn.Text = espActive and "👁️ ESP: ON" or "👁️ ESP: OFF"
        ShiftBtn.Text = shiftLockActive and "🎯 SHIFT LOCK: ON" or "🎯 SHIFT LOCK: OFF"
