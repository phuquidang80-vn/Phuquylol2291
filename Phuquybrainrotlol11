-- Remove Lava
local lavaConn
createToggle("Remove Lava", function(state)
    if state then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "Lavas" or v.Name == "Lava" then pcall(function() v:Destroy() end) end
        end
        lavaConn = workspace.DescendantAdded:Connect(function(v)
            if v.Name == "Lavas" or v.Name == "Lava" then pcall(function() v:Destroy() end) end
        end)
    else
        if lavaConn then lavaConn:Disconnect() lavaConn = nil end
    end
end)

