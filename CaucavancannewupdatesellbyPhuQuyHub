local lp = game.Players.LocalPlayer
local function Go(p, n)
    if p then
        lp.Character.HumanoidRootPart.CFrame = p.CFrame + Vector3.new(0, 3, 0)
        StatusLabel.Text = "Đã tới: " .. n
    else
        StatusLabel.Text = "Lỗi: Không tìm thấy mục tiêu!"
    end
end

