-- LOGIC CHỨC NĂNG
local function safeTP(target)
    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") and target then
        char.HumanoidRootPart.CFrame = (target:IsA("Model") and target:GetPivot() or target.CFrame) * CFrame.new(0, 5, 0)
    end
end

Btn1.MouseButton1Click:Connect(function()
    local t = workspace:FindFirstChild("Zones") and workspace.Zones:FindFirstChild("OG Area") and workspace.Zones["OG Area"].Base:FindFirstChild("IsPlatform")
    safeTP(t)
end)

Btn5.MouseButton1Click:Connect(function()
    local t = workspace:FindFirstChild("Zones") and workspace.Zones:FindFirstChild("Secret Area") and workspace.Zones["Secret Area"].Base:FindFirstChild("IsPlatform")
    safeTP(t)
end)

Btn2.MouseButton1Click:Connect(function()
    local c = workspace:FindFirstChild("FreeReward") and workspace.FreeReward:GetChildren()
    safeTP(c and c[4])
end)

Btn3.MouseButton1Click:Connect(function()
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Anchored = not hrp.Anchored
        Btn3.Text = hrp.Anchored and "☁️ Float: ON" or "☁️ Float: OFF"
        Btn3.BackgroundColor3 = hrp.Anchored and Color3.fromRGB(0, 110, 0) or Color3.fromRGB(110, 35, 35)
    end
end)

local following = false
local followConn
Btn4.MouseButton1Click:Connect(function()
    following = not following
    if following then
        Btn4.Text = "🛡️ Anti-Slap: ON"
        Btn4.BackgroundColor3 = Color3.fromRGB(0, 110, 0)
        followConn = RunService.Heartbeat:Connect(function()
            local closest = nil
            local dist = 100
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (lp.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then dist = d; closest = p end
                end
            end
            if closest and lp.Character:FindFirstChild("HumanoidRootPart") then
                lp.Character.HumanoidRootPart.CFrame = closest.Character.HumanoidRootPart.CFrame * CFrame.new(0, 4, 5)
            end
        end)
    else
        Btn4.Text = "🛡️ Anti-Slap: OFF"
        Btn4.BackgroundColor3 = Color3.fromRGB(35, 35, 110)
        if followConn then followConn:Disconnect() end
    end
end)
