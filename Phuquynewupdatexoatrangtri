end)

--- SECTION: UTILS (Công cụ xóa) ---

w:Button("Xoá CarSpawn", function()
    local carSpawn = workspace:FindFirstChild("CarSpawn")
    if carSpawn then
        carSpawn:Destroy()
    end
end)

-- Nút Xoá trang trí (Tất cả trong 1: Cây, Cỏ, Hàng rào, Đá, Đèn)
w:Button("Xoá trang trí", function()
    local assetPack = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Asset Pack V1")
    if assetPack then
        -- Danh sách các thư mục cần dọn dẹp
        local folders = {"Trees", "Bushes", "Fences", "Rocks", "Lamps"}
        
        for _, folderName in pairs(folders) do
            local folder = assetPack:FindFirstChild(folderName)
            if folder then
                for _, obj in pairs(folder:GetChildren()) do
                    obj:Destroy()
                end
            end
        end
        print("Đã dọn sạch toàn bộ vật thể trang trí!")
    else
        warn("Không tìm thấy Asset Pack V1!")
    end
end)

w:Toggle("Trạng thái Script", function(v)
   print("Script đang chạy: ", v)
end)
